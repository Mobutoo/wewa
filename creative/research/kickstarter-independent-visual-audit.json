  "findings": [
    {
      "id": "KICK-SPL-01",
      "status": "documented_form_with_unmeasured_candidate_detail",
      "confidence": "high_for_internal_splines",
      "observation": "La photo Bikebox montre clairement des cannelures dans la paroi de l’alésage fendu du moyeu. Une cannelure interne cosmétique est donc une estimation défendable pour le candidat lié.",
      "evidence": [
        "Bikebox-PA621203",
        "base-clamp-and-folding-joint",
        "folded-inner-quarter"
      ],
      "limits": "28dents, pas, profondeur et diamètre ne sont pas mesurés. Photo liée PA621203 attribuée BM150BS3 chezBikebox et V12/V15 chezPartOnWheels ; aucune compatibilité exacte125RDC certifiée."
    },
    {
      "id": "KICK-SPL-02",
      "status": "established_visible_candidate_defect_not_documented_OEM_form",
      "confidence": "high_for_visible_striation_outside_bore",
      "observation": "Dans la macro, le motif de stries s’étend hors de la paroi circulaire de l’alésage vers le pont et la face de l’oreille inférieure de charnière. Une languette/zone striée y est lisible. Ce débordement ne se confond pas avec les dents internes visibles dans le trou principal.",
      "evidence": [
        "base-clamp-and-folding-joint",
        "Bikebox-PA621203",
        "PartOnWheels-PA621203",
        "D04-sheet-29"
      ],
      "native_image_regions": [
        {
          "image": "base-clamp-and-folding-joint",
          "approx_px_box": [
            390,
            530,
            500,
            610
          ]
        },
        {
          "image": "base-clamp-and-folding-joint",
          "approx_px_box": [
            465,
            485,
            615,
            560
          ]
        }
      ],
      "documentary_comparison": "Les photos liées montrent le moyeu percé/cannelé et des surfaces de liaison métalliques sans cette bande cannelée externe. Ni le catalogue ni les vues RDC ne documentent une denture de la face de charnière.",
      "diagnosis": "Le débordement est un défaut visuel du candidat à reprendre ; il n’est pas justifié comme forme OEM ni comme simple variation défendable du nombre de dents. L’audit ne prétend pas qu’une matière a physiquement été ajoutée ou que ces lignes sont un arbre moteur réel.",
      "code_corroboration": {
        "path": "assets-src/moto-components/kickstarter/build.py",
        "lines": "30-41",
        "observation": "Le cutter d’alésage cannelé est extrudé sur w[-.06,+.06], puis soustrait à l’union déjà constituée du moyeu, des deux oreilles et des deux ponts. Cette portée traverse aussi la zone de charnière, ce qui soutient l’hypothèse d’une fuite de découpage visible.",
        "mesh_or_boolean_reexecuted": false
      },
      "action": "Limiter la denture à l’alésage du moyeu et rétablir les faces/ponts de charnière lors d’une nouvelle version, sans supprimer les véritables cannelures internes. Aucune correction faite dans cet audit."
    },
    {
      "id": "KICK-JOIN-01",
      "status": "visible_finish_concern_with_uncertain_exact_contour",
      "confidence": "medium",
      "observation": "À l’arrivée de la tige sur l’œil mobile de base, la macro montre un raccord resserré et une cassure/pli de reflet. Le bras reste visuellement relié à l’ensemble ; les vues complètes ne révèlent pas de séparation flagrante.",
      "evidence": [
        "base-clamp-and-folding-joint",
        "folded-outer-quarter",
        "folded-inner-quarter",
        "Bikebox-PA621203",
        "PartOnWheels-PA621203"
      ],
      "native_image_regions": [
        {
          "image": "base-clamp-and-folding-joint",
          "approx_px_box": [
            300,
            365,
            400,
            510
          ]
        }
      ],
      "limits": "Les angles et le chrome diffèrent ; la photo ne fournit pas de rayon de congé ni de section mesurée. Le pli de reflet ne prouve pas une fissure, une collision ou un maillage déconnecté. Les jeux entre fourchette fixe et œil mobile constituent une séparation fonctionnelle à préserver.",
      "action": "Revoir la continuité visuelle du raccord tige/œil mobile sous plusieurs angles lors de la reprise ; ne pas effacer les véritables séparations fixe/mobile pour lisser toute la base."
    },
    {
      "id": "KICK-ALL-01",
      "status": "qualitative_scope_only",
      "confidence": "medium",
      "observation": "Les quatre vues du candidat montrent le long bras coudé, le patin annelé fixe en haut et le rabattage situé à la base, cohérents dans leur organisation avec les photos liées et l’éclaté. La macro est un recadrage volontaire de la base.",
      "limits": "Pas de calibration de caméra, cotes, course, butées ou compatibilité physique récupérées. Les images entières ne résolvent pas à elles seules les défauts de la macro ; les contrôles techniques et cinématiques existants ne sont pas relancés et ne valent pas réception artistique."
    }
  ],
