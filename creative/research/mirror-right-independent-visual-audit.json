  "findings": [
    {
      "id": "MR-SIL-01",
      "classification": "qualitative_agreement_without_metric_certification",
      "evidence": [
        "whole-front",
        "whole-back",
        "official-RDC-R02",
        "DJ221004-01",
        "DJ221004-03",
        "DJ221004-04",
        "DJ221004-05"
      ],
      "observation": "La tête a une enveloppe arrondie asymétrique, une base plus étirée et un col latéral intégré. La tige coudée et la coque arrière bombée sont cohérentes dans leur organisation avec les photos liées. Pas de coin cassé ou facettisation globale flagrante visible dans ces aperçus.",
      "limits": "Rotations, projection et variante diffèrent ; la petite tête sur la vue officielle ne valide pas toutes les sections de la pièce isolée. Aucun écart de contour calibré ou dimension réelle n’est calculé. L’identitéDJ221004 reste liée, non certifiée125RDC."
    },
    {
      "id": "MR-SHL-01",
      "classification": "visible_compound_bulge_with_thickness_observability_limit",
      "evidence": [
        "whole-back",
        "joint-close",
        "DJ221004-05",
        "DJ221004-06",
        "DJ221004-07"
      ],
      "observation": "Le dos du candidat présente un bombé continu et un resserrement vers le col, tandis que les photos de profil montrent une coque effilée au bord et plus pleine vers le raccord. Le petit orifice arrière est aussi visible sur la photo07 et dans la macro du candidat.",
      "limits": "Les quatre aperçus ne donnent pas un véritable profil rasant complet de la tête. Ils ne suffisent pas à qualifier l’épaisseur totale, la profondeur du bombé ou la finesse métrique du bord. Pas de défaut certain de coque trop épaisse ou de volume trop sphérique démontré. La fonction et l’applicabilitéRDC de l’orifice restent inconnues."
    },
    {
      "id": "MR-GLS-01",
      "classification": "continuous_reflection_visible_real_curvature_unresolved",
      "evidence": [
        "whole-front",
        "DJ221004-03",
        "DJ221004-04"
      ],
      "observation": "Le verre reflète les grandes formes du studio de façon continue ; aucune ondulation grossière, ouverture ou éclatement de reflet n’est visible à cette résolution. Le bord noir suit l’enveloppe de la face.",
      "limits": "Les reflets rectangulaires du studio et les plafonds/inscriptions des photos ne constituent pas une même mire. Ils ne donnent ni rayon de courbure ni grossissement calibré. Les paramètres de travail2m/2.5mm indiqués auREADME ne sont pas des mesures photographiques. Aucune fidélité optique ou parité glTF/Blender n’est certifiée."
    },
    {
      "id": "MR-JNT-01",
      "classification": "visible_overlap_consistent_with_related_photos",
      "evidence": [
        "joint-close",
        "whole-back",
        "DJ221004-01",
        "DJ221004-05",
        "DJ221004-06",
        "DJ221004-07"
      ],
      "observation": "Les caches du col se recouvrent visuellement, avec une lèvre et deux gorges ; la boule de réglage n’est pas exposée. La ligne sombre au changement de cache est compatible avec les jonctions de pièces séparées visibles sur les photos. Aucun ancien jour axial ouvert n’est observé dans ces quatre aperçus.",
      "limits": "La macro présente une lèvre assez franche, mais les angles et l’éclairage empêchent de certifier son profil exact, sa largeur, le jeu ou le mécanisme caché. Aucun pincement ou conflit de surface avéré n’est conclu de cette ligne sombre."
    },
    {
      "id": "MR-BAS-01",
      "classification": "established_visible_difference_from_attributed_related_product",
      "evidence": [
        "base-close",
        "whole-front",
        "DJ221004-01",
        "DJ221004-03",
        "DJ221004-05",
        "DJ221004-06"
      ],
      "native_image_region": {
        "image": "base-close",
        "approx_px_box": [
          300,
          295,
          405,
          365
        ]
      },
      "observation": "Le candidat expose une bande de filetage brillant entre le bas du cache de base et le dessus de l’écrou. Sur les photos liées01/03/05, le cache se trouve au voisinage immédiat de l’écrou sombre ; le filetage est surtout visible sous cet écrou. Cette différence d’aspect/assemblage est lisible et ne dépend pas d’une mesure en pixels.",
      "limits": "Ce constat ne certifie pas une cote de montage actuelleRDC : la référence est liée, la base dépend du frein voisin estimé, et le modèle est montré démonté. Le métal du candidat paraît aussi plus clair que l’écrou photographié, mais teinte et brillance ne sont pas calibrées.",
      "action": "Revoir l’intervalle cache/écrou avant de clôturer les vues finales de cette version. Conserver les aperçus actuels comme diagnostics historiques ; revoir séparément une nouvelle source.",
      "fabricator_response": {
        "author": "/root/instrument_references",
        "statement": "C confirme un intervalle de construction environ6.7mm entre cachebas q=.020 et écrouhaut q=.0133, et reprend l’interface avant96.",
        "independent_photo_measurement": false,
        "candidate_parameter_measurement_independently_rerun": false
      }
    }
  ],
