{
  "version": "1.0",
  "v0": "explicit_mode_choice_only",
  "remote_telemetry_v0": false,
  "local_events": [
    "run_start",
    "run_end",
    "mode",
    "active_duration",
    "deliveries",
    "score",
    "collisions",
    "camera",
    "assist_choice"
  ],
  "later_rules": {
