{
  "name": "viva-wewa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite app --host 0.0.0.0",
    "build": "tsc --noEmit -p app/tsconfig.json && vite build app --outDir ../dist",
    "preview": "vite preview app --outDir ../dist --host 0.0.0.0",
    "test": "vitest run app/src",
    "test:browser": "python3 tools/browser_checks.py"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
